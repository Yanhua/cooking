rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function householdMember(uid) {
      // Replace this with the one Firebase Authentication user's UID.
      return request.auth != null
        && request.auth.uid == '6BghJs4kuRbkGOrlrx5Cay54JNE3'
        && uid == request.auth.uid;
    }
    match /households/{uid}/records/{recordId} {
      allow read: if householdMember(uid);
      // Planner-owned JSON stays opaque so draft and saved-week payloads can add
      // fields such as suggestion history and ingredient checklist state while
      // the record envelope remains strict.
      allow create, update: if householdMember(uid)
        && recordId.matches('^(draft|week-[0-9]{4}-[0-9]{2}-[0-9]{2}|tried-[a-z0-9-]+|comment-[a-z0-9-]+|favourite-[a-z0-9-]+)$')
        && request.resource.data.keys().hasOnly(['payload', 'revision', 'updatedAt'])
        && request.resource.data.payload is string
        && request.resource.data.payload.size() < 900000
        && request.resource.data.revision is int
        && request.resource.data.revision == (resource == null ? 1 : resource.data.revision + 1)
        && request.resource.data.updatedAt == request.time;
      // Soft deletion is a versioned JSON null, preventing stale tabs resurrecting data.
      allow delete: if false;
    }
  }
}
